# Copy this file to ".env" (same folder) and edit.
#
# "mock"  -> no backend needed: products come from src/data/legacyProducts.js,
#            accounts/cart/orders live in your browser. For previewing the UI only.
# "real"  -> talk to the Express backend (built in the next stages).
VITE_API_MODE=mock

# Only used when VITE_API_MODE=real and the frontend is deployed separately
# from the backend. Leave unset in development (Vite proxies /api for you).
# VITE_API_URL=https://api.your-domain.com/api
